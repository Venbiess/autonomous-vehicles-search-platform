# Copy to .env in repository root when running `docker compose` from root.
# This file is auto-read by Docker Compose from the current working directory.

# Enable hot reload for master-server + frontend (including pages/api analytics routes)
AVSP_DEV_RELOAD=0

# Optional model build/runtime overrides
EMBEDDER_ATTN_IMPLEMENTATION=
VLM_DEBUG_EMPTY_OUTPUT=0

# Optional VLM backend override (SMOLVLM, QWEN, OPENAI)
VLM_BACKEND=SMOLVLM
VLM_MODEL_NAME=

# Worker restart behavior
EMBEDDER_WORKER_RESTART_POLICY=no
VLM_WORKER_RESTART_POLICY=no

# Master model-readiness checks
MODEL_BACKEND_READY_WAIT_SEC=45
MODEL_BACKEND_READY_POLL_SEC=1

# VLM backfill behavior (master-server)
VLM_RETRY_EMPTY_VALUES=1
VLM_BACKFILL_FIELD_CHUNK_SIZE=0

# OpenAI VLM settings (used when VLM_BACKEND=OPENAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
VLM_OPENAI_API_KEY=
VLM_OPENAI_BASE_URL=
VLM_OPENAI_ORG_ID=
VLM_OPENAI_PROJECT_ID=
VLM_OPENAI_TIMEOUT_SEC=120
VLM_OPENAI_MAX_RETRIES=2
VLM_OPENAI_IMAGE_DETAIL=low
VLM_OPENAI_IMAGE_FORMAT=jpeg
VLM_OPENAI_JPEG_QUALITY=95
VLM_OPENAI_TEMPERATURE=
VLM_OPENAI_SYSTEM_PROMPT=
VLM_OPENAI_BATCH_POLL_SEC=15
VLM_OPENAI_BATCH_SCENE_CHUNK_SIZE=32
VLM_OPENAI_BATCH_MAX_INPUT_BYTES=190000000
VLM_OPENAI_BATCH_COMPLETION_WINDOW=24h
